{
    "extends": "@fkui/tsconfig/recommended",
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "${configDir}/temp/tsconfig.pageobjects.tsbuildinfo",
        "types": ["cypress"],
        "emitDeclarationOnly": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,

        /* stricter config */
        "allowUnusedLabels": false,
        "allowUnreachableCode": false,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "${configDir}/src/cypress/**/*.ts",
        "${configDir}/src/cypress/**/*.mts",
        "${configDir}/src/selectors/**/*.ts", // needed when cypress pageobjects references selector objects
        "${configDir}/src/**/*.pageobject.ts",
        "${configDir}/src/**/*.pageobject.mts"
    ],
    "exclude": ["${configDir}/src/**/*.cy.ts", "${configDir}/src/**/*.spec.ts"]
}
